# Fixture-only network-capable variant. The ordinary Harbor image stays offline.
ARG BASE_IMAGE=entryplug-harbor:jazzy
FROM ${BASE_IMAGE}

USER root
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --break-system-packages \
    paho-mqtt==2.1.0 eclipse-zenoh==1.10.1 aiohttp==3.14.3
USER entryplug

RUN python3 -c "import paho.mqtt.client; import zenoh; import entryplug_harbor.mqtt_light"
RUN python3 -m pytest -q -p no:cacheprovider optional_tests/zenoh optional_tests/mqtt
